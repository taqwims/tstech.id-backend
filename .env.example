# ===================================================
# TsTech Backend Environment Variables (Production)
# ===================================================

# ---------------------------------------------------
# 1. Database (Neon.tech PostgreSQL)
# ---------------------------------------------------
# Masukkan connection string langsung dari Neon.tech Dashboard:
DATABASE_URL="postgtheast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Atau gunakan variabel terpisah jika tidak menggunakan DATABASE_URL:
# DB_DRIVER=postgres
# DB_HOST=ep-xyz-123456.ap-southeast-1.aws.neon.tech
# DB_PORT=5432
# DB_USER=neondb_owner
# DB_PASSWORD=YOUR_PASSWORD
# DB_NAME=neondb
# DB_SSLMODE=require

# ---------------------------------------------------
# 2. Server API (Render Web Service)
# ---------------------------------------------------
API_ENV=production
# Render otomatis menyuntikkan $PORT, tapi bisa didefinisikan jika perlu:
# PORT=8080

# ---------------------------------------------------
# 3. Cloudflare R2 Storage (S3-Compatible)
# ---------------------------------------------------
# Dapatkan dari Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=e4a8102b7723e65d0d0659a2c8e609c6
R2_ACCESS_KEY_ID=cc07ebc20503151d26a32dc66f711a90
R2_SECRET_ACCESS_KEY=1d9ccecb4a8e43ad639ca08e20082d9e928ff5dae0ae65263efabeb38559fa9b
R2_BUCKET_NAME=sucommerce
# Public URL dari custom domain R2 atau R2.dev (contoh: https://pub-xxx.r2.dev atau https://cdn.tstech.id)
R2_PUBLIC_URL=https://pub-88517502438642168ebfecf31829e56b.r2.dev

# ---------------------------------------------------
# 4. Authentication (JWT) & Admin Seed
# ---------------------------------------------------
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_HOURS=168
ADMIN_EMAIL=admin@tstech.id
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin TsTech

# ---------------------------------------------------
# 5. Frontend & App URL
# ---------------------------------------------------
APP_URL=https://tstech.id
APP_NAME=TsTech
WHATSAPP_NUMBER=628812209692

# ---------------------------------------------------
# 6. Payment Gateway (iPaymu / Mayar / Pakasir)
# ---------------------------------------------------
IPAYMU_VA=your_ipaymu_va
IPAYMU_API_KEY=your_ipaymu_api_key
IPAYMU_IS_PRODUCTION=true
IPAYMU_RETURN_URL=https://tstech.id/pemesanan/sukses
IPAYMU_CANCEL_URL=https://tstech.id/pemesanan/batal
IPAYMU_NOTIFY_URL=https://your-backend.onrender.com/api/payments/notify

# ---------------------------------------------------
# 7. SMTP Email
# ---------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="05taqwim@gmail.com"
SMTP_PASSWORD="pjsn pjje bfqh vwey"
SMTP_FROM_NAME=TSTech
SMTP_FROM_EMAIL=noreply@tstech.id

# ---------------------------------------------------
# 8. SaaS Satellites & SSO Routing
# ---------------------------------------------------
# Production:
# SAAS_BASE_DOMAIN=tstech.id
# SAAS_SSO_PROTOCOL=https
# HUB_API_URL=https://api.tstech.id/api
# Kosongkan SAAS_DEV_URL_OVERRIDE di production agar menggunakan full subdomain:
# SAAS_DEV_URL_OVERRIDE=

# Development (Contoh jika ingin mengarahkan SSO ke localhost):
SAAS_BASE_DOMAIN=tstech.id
SAAS_SSO_PROTOCOL=http
HUB_API_URL=http://localhost:8080/api
SAAS_DEV_URL_OVERRIDE=http://localhost:5173
